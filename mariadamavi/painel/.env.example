# Copie para .env e preencha. O .env NUNCA vai para o git.

# Onde o painel escuta (o Nginx encaminha para cá).
HOST=127.0.0.1
PORT=3030
TZ=America/Sao_Paulo

# Login: gere as duas linhas com `npm run senha -- "sua senha"`.
PAINEL_SENHA_HASH=
SESSION_SECRET=
# 1 quando estiver atrás de HTTPS (produção).
PAINEL_COOKIE_SECURE=1

# demo = dados fictícios | mercadophone = API real
FONTE=demo
CACHE_MINUTOS=5
MESES_HISTORICO=18

# API do Mercado Phone (preencher com a documentação que eles liberarem).
MP_API_BASE=
MP_API_TOKEN=
MP_AUTH_HEADER=Authorization
MP_AUTH_PREFIX="Bearer "
MP_PATH_ESTOQUE=/estoque
MP_PATH_VENDAS=/vendas
MP_PATH_FINANCEIRO=/financeiro
MP_PARAM_ZERADOS=zero_or_negative_stock
MP_POR_PAGINA=100
